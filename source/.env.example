# Copy sang .env (KHÔNG commit file .env).
# Các bí mật để TRỐNG: tự tạo giá trị riêng, ví dụ
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET >= 32 ký tự; INTERNAL_SERVICE_KEY >= 16 ký tự; mật khẩu >= 8 ký tự.

JWT_SECRET=
# Database-per-Service: mỗi service có MongoDB riêng (chỉ mở cho máy local, dùng Compass để xem):
#   Auth    mongodb://localhost:27018 -> zoo_auth    (users, tickets)
#   Content mongodb://localhost:27019 -> zoo_content (pois, events)
#   Audio   mongodb://localhost:27020 -> zoo_audio   (audio_tracks)
# Service KHÔNG đọc DB của nhau: Content/Audio hỏi vé qua Auth Service (/internal/*).
AUTH_DB_NAME=zoo_auth
CONTENT_DB_NAME=zoo_content
AUDIO_DB_NAME=zoo_audio
AUTH_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8002

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
COUNTER_USERNAME=counter01
COUNTER_PASSWORD=change-me-counter-password

INTERNAL_SERVICE_KEY=change-me-internal-key
PUBLIC_BASE_URL=http://localhost

TICKET_TTL=end_of_day
ACTIVATED_TICKET_TTL_SECONDS=60
ACTIVATE_RATE_LIMIT=20
ACTIVATE_RATE_WINDOW_SEC=60
TICKET_LOOKUP_CACHE_TTL=2
N_ACTIVE_MINUTES=10
# Giai đoạn 4 — sự kiện và thống kê (Content Service)
PRESENCE_ENTER_TTL_MINUTES=120
EVENT_DEDUPE_SECONDS=30
EVENT_RATE_LIMIT=30
EVENT_RATE_WINDOW_SEC=60
GEO_TOLERANCE_M=20
EVENT_REQUIRE_GPS=false
STAFF_TOKEN_HOURS=8
EDGE_TTS_TIMEOUT_SEC=45

VITE_API_BASE_URL=
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_PUBLIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MYMEMORY_EMAIL=