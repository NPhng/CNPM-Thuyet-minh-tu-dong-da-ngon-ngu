# Copy sang .env (không commit file .env)

JWT_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb://localhost:27017
DB_NAME=zoo

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
COUNTER_USERNAME=counter01
COUNTER_PASSWORD=change-me-counter-password

INTERNAL_SERVICE_KEY=change-me-internal-key
PUBLIC_BASE_URL=https://zoo.example.com

TICKET_TTL=end_of_day
ACTIVATE_RATE_LIMIT=20
ACTIVATE_IP_RATE_LIMIT=300
ACTIVATE_RATE_WINDOW_SEC=60
TICKET_LOOKUP_CACHE_TTL=2
N_ACTIVE_MINUTES=10
# Giai đoạn 4 — sự kiện và thống kê (Content Service)
PRESENCE_ENTER_TTL_MINUTES=120
EVENT_DEDUPE_SECONDS=30
EVENT_RATE_LIMIT=30
EVENT_RATE_WINDOW_SEC=60
GEO_TOLERANCE_M=20
EVENT_REQUIRE_GPS=false
STAFF_TOKEN_HOURS=8

VITE_API_BASE_URL=
